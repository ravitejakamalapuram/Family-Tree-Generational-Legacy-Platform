{
  "name": "family-legacy",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:web": "npm --workspace @family-legacy/web run dev",
    "build:web": "npm --workspace @family-legacy/web run build",
    "typecheck:web": "npm --workspace @family-legacy/web run typecheck",
    "test:web": "npm --workspace @family-legacy/web run test",
    "lint:web": "npm --workspace @family-legacy/web run lint",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  }
}